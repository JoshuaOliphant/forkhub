# ABOUTME: Schedule the optional ForkHub GitHub refresh every six hours.
# ABOUTME: Spread startup requests and leave model analysis disabled in the service.
[Unit]
Description=Schedule ForkHub cache refresh

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
RandomizedDelaySec=10min
Persistent=yes
Unit=forkhub-sync.service

[Install]
WantedBy=timers.target
