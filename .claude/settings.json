{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -qE '\\.py$' && uv run ruff format \"$f\" || true; } 2>/dev/null || true",
            "statusMessage": "Formatting Python file...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.command' | grep -q 'git commit' && { uv run ruff format --check src/ tests/ 2>&1 && uv run ruff check src/ tests/ 2>&1; } || true",
            "statusMessage": "Checking ruff format + lint...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/harness/observability/start.sh",
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ]
  }
}
